# API pública (dashboard -> backend). NEXT_PUBLIC_ porque se usa desde
# código de cliente (dashboard/lib/api.ts, dashboard/lib/auth.ts).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth (multi-user-auth) — secreto compartido para verificar el JWT de
# sesión en dashboard/middleware.ts (usa la librería `jose`, Edge runtime).
# Sin prefijo NEXT_PUBLIC_ a propósito: se lee solo server-side dentro del
# middleware, nunca debe llegar al bundle del cliente.
#
# DEBE tener EXACTAMENTE el mismo valor que AUTH_SECRET_KEY en el .env del
# backend (ver .env.example en la raíz del repo / settings.auth_secret_key
# en src/config/settings.py) — si no coinciden, todo token válido emitido
# por la API es rechazado por el middleware y el login queda en loop de
# redirect a /login.
#
# Generar un valor real con `openssl rand -hex 32`. Copiar este archivo a
# dashboard/.env.local (gitignored, ver dashboard/.gitignore) para desarrollo
# local — nunca commitear el valor real acá.
AUTH_SECRET_KEY=

# Invitaciones por email (email-invitations) — TODAS server-side, ninguna
# lleva prefijo NEXT_PUBLIC_. Las lee únicamente
# dashboard/app/api/invitations/send/route.ts (runtime nodejs).

# API key de Resend. SIN prefijo NEXT_PUBLIC_ a propósito: si se expusiera,
# quedaría en el bundle del cliente y cualquiera podría enviar emails con la
# cuenta de GeoSpectrum. Se carga en Vercel como env de servidor.
RESEND_API_KEY=

# URL base pública del dashboard, usada para armar el link de la invitación
# (`${INVITE_BASE_URL}/invite/{token}`). En producción:
# https://geospectrum.org. Si no está definida, la route cae al origin del
# request — suficiente en desarrollo local, NO en producción detrás de proxy.
INVITE_BASE_URL=http://localhost:3008

# Remitente de los emails transaccionales. Opcional: si no se define, se usa
# 'GeoSpectrum <invitaciones@geospectrum.org>' (dominio ya verificado en
# Resend con SPF/DKIM). Solo tocar para cambiar de casilla o de dominio.
RESEND_FROM=
