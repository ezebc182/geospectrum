# Región de monitoreo (bbox Andes Argentina-Chile)
REGION_MINLAT=-40
REGION_MAXLAT=-20
REGION_MINLON=-75
REGION_MAXLON=-60

# Umbral mínimo de magnitud para alertas
MIN_MAG_ALERT=3.0

# Timeouts (segundos)
USGS_TIMEOUT_S=5.0
INPRES_TIMEOUT_S=5.0

# Ventana de análisis (minutos)
WINDOW_MINUTES=60

# INPRES adapter interno (ver deploy/docker/docker-compose.yml)
# Para desarrollo local, dejar vacío para usar solo USGS
# Para Docker: http://inpres-adapter:8001/recent
INPRES_PROXY_URL=

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# Rate limiting (opcional, para future)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# Observability
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# Storage opcional (para histórico)
TIMESCALEDB_HOST=
TIMESCALEDB_PORT=5432
TIMESCALEDB_DB=seismic
TIMESCALEDB_USER=
TIMESCALEDB_PASSWORD=

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# SSE
MAX_SSE_CLIENTS=200
SSE_HEARTBEAT_SECONDS=30
SSE_REPLAY_WINDOW_HOURS=24

# Archive
ARCHIVE_DIR=/data/events-archive

# Observability (GlitchTip)
GLITCHTIP_DSN=
GLITCHTIP_DSN_FRONTEND=
ENVIRONMENT=development
GIT_SHA=unknown
GLITCHTIP_TRACES_SAMPLE_RATE=0.1

# CORS (comma-separated origins allowed)
CORS_ALLOWED_ORIGINS=http://localhost:3008,http://localhost:3000
