# Región de monitoreo (bbox Andes Argentina-Chile)
REGION_MINLAT=-40
REGION_MAXLAT=-20
REGION_MINLON=-75
REGION_MAXLON=-60

# Umbral mínimo de magnitud para alertas
MIN_MAG_ALERT=3.0

# Timeouts (segundos)
USGS_TIMEOUT_S=5.0
INPRES_TIMEOUT_S=5.0

# Ventana de análisis (minutos)
WINDOW_MINUTES=60

# INPRES adapter interno (ver deploy/docker/docker-compose.yml)
# Para desarrollo local, dejar vacío para usar solo USGS
# Para Docker: http://inpres-adapter:8001/recent
INPRES_PROXY_URL=

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# Rate limiting (opcional, para future)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# Observability
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# Storage opcional (para histórico)
# Nota: en docker-compose local el contenedor mapea a 5433 en el host para
# no chocar con un Postgres nativo que pueda estar corriendo en 5432.
TIMESCALEDB_HOST=
TIMESCALEDB_PORT=5433
TIMESCALEDB_DB=seismic
TIMESCALEDB_USER=
TIMESCALEDB_PASSWORD=

# Auth (multi-user-auth) — requiere TIMESCALEDB_* arriba seteado y las
# migraciones deploy/sql/migrations/001_create_users_table.sql y
# 002_add_role_hierarchy.sql aplicadas manualmente contra ese Postgres antes
# de levantar el servicio (no hay Alembic/migrador automático en este
# proyecto). Sin AUTH_SECRET_KEY el arranque de la API falla fail-fast (ver
# lifespan() en src/main.py) — no es opcional/best-effort como Redis.
# Generar un valor real con `openssl rand -hex 32`, nunca commitear el valor
# real. DEBE coincidir exactamente con AUTH_SECRET_KEY en
# dashboard/.env.local (mismo secreto compartido para firmar/verificar el
# JWT, ver dashboard/middleware.ts).
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=1440

# Invitaciones (email-invitations) — requiere la migración
# deploy/sql/migrations/007_invitations.sql aplicada manualmente contra el
# mismo Postgres antes de desplegar el código nuevo. Días de vigencia de una
# invitación desde su creación. OPCIONAL: tiene default 7 en código (sin
# fail-fast); la expiración se evalúa al leer (`expires_at > now()`), no hay
# worker que marque expiradas.
INVITATION_EXPIRE_DAYS=7

# Google OAuth (google-oauth) — extensión opcional de Auth arriba. Requiere
# que la migración deploy/sql/migrations/003_add_google_oauth.sql esté
# aplicada manualmente contra el mismo Postgres antes de desplegar el código
# nuevo. A diferencia de AUTH_SECRET_KEY, estas 3 variables son OPCIONALES:
# si faltan, la API arranca igual (google_oauth_configured=False), los
# endpoints /auth/google/* responden 503, y el login por password no se ve
# afectado. Obtener las credenciales desde Google Cloud Console (OAuth 2.0
# Client IDs). El dashboard NO necesita las credenciales: el redirect es
# 100% server-side vía este backend (ver dashboard/lib/auth.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# URL pública del dashboard (Next.js) — a diferencia de las 3 vars de
# arriba, esta SÍ es necesaria para que el login por Google funcione: es el
# destino del 302 final de /auth/google/callback (éxito y error). Si se deja
# vacía o mal seteada, el usuario termina viendo la respuesta JSON de esta
# API en vez de su sesión en el dashboard (una ruta relativa se resolvería
# contra este backend, no contra el dashboard, que corre en otro origen).
# Default en código: http://localhost:3008 (dev local).
DASHBOARD_URL=

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# SSE
MAX_SSE_CLIENTS=200
SSE_HEARTBEAT_SECONDS=30
SSE_REPLAY_WINDOW_HOURS=24

# Archive
ARCHIVE_DIR=/data/events-archive

# Observability (GlitchTip)
GLITCHTIP_DSN=
GLITCHTIP_DSN_FRONTEND=
ENVIRONMENT=development
GIT_SHA=unknown
GLITCHTIP_TRACES_SAMPLE_RATE=0.1

# CORS (comma-separated origins allowed)
CORS_ALLOWED_ORIGINS=http://localhost:3008,http://localhost:3000

# Watchdog de servicios (Railway)
# Detecta el "falso vivo": procesos que siguen corriendo pero dejaron de
# producir algo útil (Railway solo reinicia si el proceso muere de verdad).
# WATCHDOG_ENABLED=false
# WATCHDOG_NTFY_TOPIC_URL=https://ntfy.sh/geospectrum-watchdog-02d73c9b7f34
# WATCHDOG_INTERVAL_SECONDS=300
# WATCHDOG_API_URL=https://api.geospectrum.org/health
# WATCHDOG_UI_URL=
# WATCHDOG_SEEDLINK_STALE_AFTER_SECONDS=600
# WATCHDOG_EVENTS_HEARTBEAT_TTL_SECONDS=180
# WATCHDOG_EVENTS_HEARTBEAT_INTERVAL_SECONDS=60
